# LenaBeauty — Environment template.
# Copy to `.env` for local dev. NEVER commit real values.
# For hosted deployments, set these in the Vercel dashboard
# (Project -> Settings -> Environment Variables), NOT in vercel.json.

VITE_DATA_BACKEND=supabase

# Explicit deployment environment: development | staging | production.
# Optional — local/test builds default to development; optimized builds default
# to staging. NOTE: a production build NEVER falls back to demo credentials; it
# fails closed unless the explicit values below are provided.
VITE_ENVIRONMENT=development

# Demo credentials for local development / trial — ONLY used when all of the
# following hold: (1) the build is NOT a production build, (2) the environment
# is not `production`, and (3) this flag is exactly "true". Production builds
# ignore this flag and fail closed instead of silently pointing at the demo
# project. See src/config/env.ts.
VITE_USE_DEMO_CREDENTIALS=false

# From Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# The center UUID seeded by migration 20260623000001_initial_schema.sql.
# This is a REAL deployment value — the placeholder below will fail the
# center-membership check at login. For the canonical single-branch deploy,
# set it to the seed center UUID:
#   VITE_CENTER_ID=7f0b8e2a-6d5a-4a1b-9c2d-3e4f5a6b7c8d
VITE_CENTER_ID=00000000-0000-0000-0000-000000000000

VITE_BRANCH_MODE=single
