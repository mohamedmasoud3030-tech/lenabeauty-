{
  "name": "salon-management-pwa",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "preflight:supabase": "node scripts/supabase-live-preflight.mjs",
    "launch:preflight": "node scripts/launch/production-preflight.mjs",
    "ci:rpc-check": "node scripts/check-rpc-contracts.mjs",
    "ci:migrations": "node scripts/check-migration-chain.mjs",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:types:check": "node scripts/generate-database-types.mjs --check",
    "audit:replay": "node scripts/audit/replay-schema.mjs",
    "audit:scan": "node scripts/audit/scan-frontend.mjs",
    "audit:matrix": "node scripts/audit/build-matrix.mjs",
    "audit:all": "npm run audit:replay && npm run audit:scan && npm run audit:matrix",
    "audit:gate": "node scripts/audit/ci-gate.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && node scripts/lint-source.mjs",
    "test": "vitest run",
    "desktop:dev": "vite --host 127.0.0.1 --port 1420",
    "desktop:build:web": "vite build",
    "desktop:tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "desktop:test": "vitest run src/__tests__/tauri-foundation.test.ts src/__tests__/desktop-bridge.test.ts src/__tests__/tauri-rust-files.test.ts src/__tests__/desktop-print-integration.test.ts src/__tests__/landing-page-alignment.test.ts src/__tests__/desktop-native-readiness.test.ts",
    "desktop:preflight": "npm run typecheck && npm run desktop:test && npm run build && npm run desktop:tauri:check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "i18next": "^25.8.13",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  }
}